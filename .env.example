# FredTux 2.0 – Geheimnisse
#
# Diese Datei wird von FredTux NICHT automatisch gelesen. Zum Verwenden:
#
#     set -a; source .env; set +a
#
# Danach haben die Werte Vorrang vor config.nd und shell.nd.
#
# Hier gehören ausschließlich Geheimnisse hinein. Alle übrigen
# Einstellungen stehen in config.nd, die Shell-Sicherheitsstufen in shell.nd.
# Diese Datei wird nicht versioniert; .env.example ist die Vorlage.

FREDTUX_API_KEY=
